{
  "mcpServers": {
    "vercel": {
      "command": "npx",
      "args": [
        "-y",
        "--package=ajv",
        "--package=@vineethnkrishnan/vercel-mcp",
        "vercel-mcp"
      ],
      "env": {
        "VERCEL_TOKEN": "${VERCEL_TOKEN}",
        "VERCEL_TEAM_ID": "${VERCEL_TEAM_ID}"
      }
    }
  }
}
