# Database (PostgreSQL / Supabase Transaction Pooler)
# Local development: postgresql+psycopg://postgres:postgrespassword@localhost:5432/syllabustutor
# Supabase Production: use Transaction Pooler port 6543 (DO NOT add ?pgbouncer=true —
#   psycopg v3 does not support it as a libpq option; prepared statements are disabled
#   automatically via connect_args when port 6543 or a Supabase host is detected)
DATABASE_URL=postgresql+psycopg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=15
DB_POOL_RECYCLE=300
LLM_TIMEOUT_SECONDS=15.0

# Google Gemini API
GEMINI_API_KEY=your_google_gemini_api_key_here

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Supabase (Storage & PGVector)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_role_key

# CORS & Server Config
CORS_ORIGIN=http://localhost:5173
PORT=8000
