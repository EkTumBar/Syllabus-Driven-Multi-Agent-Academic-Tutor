# ==============================================================================
# Syllabus-Driven Multi-Agent Academic Tutor - Backend Environment Variables
# ==============================================================================

# Database Connection (Supabase PostgreSQL / Local Postgres)
DATABASE_URL=postgresql+psycopg://postgres:<PASSWORD>@<HOST>:<PORT>/postgres
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=15
DB_POOL_RECYCLE=300

# LLM & Timeout Configuration
# Allow 120-180 seconds for multi-agent syllabus planning and batch MCQ pre-generation
LLM_TIMEOUT_SECONDS=180.0

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Authentication (JWT)
JWT_SECRET=replace_with_a_secure_random_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Supabase Storage & Database
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_or_publishable_key
SUPABASE_ACCESS_TOKEN=your_supabase_service_role_or_access_token
SUPABASE_PROJECT_ID=your_supabase_project_id

# Server & CORS Configuration
PORT=8000
CORS_ORIGIN=http://localhost:5173
